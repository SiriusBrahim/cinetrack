    "test:taste": "node scripts/run-tests.mjs taste",
    "cycles": "node scripts/check-cycles.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@respan/respan": "2.5.0",

    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "framer-motion": "^14.9.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
